# 파이썬 실행 부산물
__pycache__/
*.pyc
.venv
.pytest_cache/
# 내려받은 원천 데이터와 캐시(용량이 크고, 코드로 언제든 다시 받을 수 있음) (맥북에선 심볼릭 링크라 끝에 / 없이)
data
# 비밀값(API 키)은 절대 올리지 않음
.env
*.key
.DS_Store

# 실행 결과(실행할 때마다 다시 만들어짐). 맥북에서 실행해도 Pull 충돌이 안 나도록 git 에서 뺌(2026-11-03).
# 공유할 결과는 results/ 에 스냅샷으로 둔다(코드는 results/ 에 쓰지 않음).
outputs/
